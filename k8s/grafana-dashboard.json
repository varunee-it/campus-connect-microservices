      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total[1m])) by (route)",
          "legendFormat": "Route: {{route}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Request Rate by Route (req/sec)",
