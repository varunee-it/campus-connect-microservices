# ========================================================
# CampusConnect Lab 8 - Kubernetes Secrets Template
# KEEP REAL SECRETS OUT OF VERSION CONTROL
# Copy to k8s/secret.yaml and fill in your MongoDB Atlas URIs
# ========================================================
apiVersion: v1
kind: Secret
metadata:
  name: campus-secrets
  namespace: lab8
  labels:
    app.kubernetes.io/part-of: campus-connect
type: Opaque
stringData:
  USER_SERVICE_MONGO_URI: "mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campus_user_db?retryWrites=true&w=majority"
  PRODUCT_SERVICE_MONGO_URI: "mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campus_product_db?retryWrites=true&w=majority"
  ORDER_SERVICE_MONGO_URI: "mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campus_order_db?retryWrites=true&w=majority"
