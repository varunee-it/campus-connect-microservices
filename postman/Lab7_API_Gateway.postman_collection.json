    {
      "name": "4. Resilience & Error Handling",
      "item": [
        {
          "name": "Unreachable Service (Expect 502/503)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            },
            "description": "Send request when Product Service is offline or misconfigured to verify centralized 502 Bad Gateway response."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 502 or 503\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([502, 503]);",
                  "});",
                  "pm.test(\"Error response contains Bad Gateway details\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error).to.be.oneOf([\"Bad Gateway\", \"Service Unavailable\"]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Recovery Verification (Expect 200 OK)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            },
            "description": "Send request after restarting the target service to confirm automatic recovery and healthy 200 response without restarting the gateway."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK upon recovery\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Service returned healthy product list\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(Array.isArray(json)).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
