# ========================================================
# CampusConnect Lab 7 - Environment Configuration Template
# KEEP REAL SECRETS OUT OF VERSION CONTROL
# Copy this file to .env and supply your local or cloud values
# ========================================================

# API Gateway Configuration
PORT=8000

# Service Discovery Registry (Gateway -> Microservices)
# For local Docker Compose, use internal service names:
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003

# Inter-service Communication (Order Service -> User / Product Services)
ORDER_SERVICE_USER_URL=http://user-service:3001
ORDER_SERVICE_PRODUCT_URL=http://product-service:3002

# MongoDB Atlas Connection Strings (DO NOT COMMIT REAL CREDENTIALS)
USER_SERVICE_MONGO_URI=
PRODUCT_SERVICE_MONGO_URI=
ORDER_SERVICE_MONGO_URI=
